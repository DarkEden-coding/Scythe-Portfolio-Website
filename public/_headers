# Cloudflare joins the values when two rules set the same header, so keep these paths apart.
# HTML keeps Cloudflare's default (max-age=0, must-revalidate) so a deploy shows up at once.

# Built by Vite with a content hash in the name.
/assets/*
  Cache-Control: public, max-age=31536000, immutable

# The site fetches these as /cubes/<preset>-<n>.cube?v=<CUBE_VERSION>, and the version changes
# whenever the baked set does (src/presets.ts).
/cubes/*
  Cache-Control: public, max-age=31536000, immutable
  Content-Type: application/octet-stream

# Unversioned files at fixed URLs (link previews, icons, crawlers): cache, but not for long.
/brand/*
  Cache-Control: public, max-age=86400
/og.jpg
  Cache-Control: public, max-age=86400
/favicon.png
  Cache-Control: public, max-age=86400
/icon-192.png
  Cache-Control: public, max-age=86400
/apple-touch-icon.png
  Cache-Control: public, max-age=86400
/site.webmanifest
  Cache-Control: public, max-age=86400
/contributions.json
  Cache-Control: public, max-age=3600
/robots.txt
  Cache-Control: public, max-age=3600
/sitemap.xml
  Cache-Control: public, max-age=3600
