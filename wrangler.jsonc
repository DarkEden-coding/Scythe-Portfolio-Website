{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "scythe-portfolio",
  "compatibility_date": "2026-11-01",
  // Static site only: no Worker script, Cloudflare serves dist/ directly.
  "assets": {
    "directory": "./dist"
  },
  "routes": [
    { "pattern": "elliotscully.dev", "custom_domain": true },
    { "pattern": "www.elliotscully.dev", "custom_domain": true }
  ]
}
